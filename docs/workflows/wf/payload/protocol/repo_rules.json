  "setup.cfg",
  "setup.py",
  "requirements.txt",
  "requirements-*.txt",
  "package.json",
  "package-lock.json",
  "pnpm-lock.yaml",
  "yarn.lock",
  "Pipfile",
  "Pipfile.lock",
  "poetry.lock",
  "uv.lock",
  "Cargo.toml",
  "Cargo.lock",
  "go.mod",
  "go.sum",
  "Gemfile",
  "Gemfile.lock",
  "composer.json",
  "composer.lock",
  "Makefile",
  "tox.ini",
  "noxfile.py",
  ".pre-commit-config.yaml",
  ".github/workflows/**",
  ".gitlab-ci.yml",
  ".circleci/**",
  "azure-pipelines.yml",
  "Jenkinsfile"
 ],
 "why": "这些文件的改动会改变所有后续任务的行为环境（构建、依赖、CI、提交过滤），因此属 K6 第 5 类不可逆动作：改一次就要一次显式确认。"
