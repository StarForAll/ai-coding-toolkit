+def restart(ctx, task, decision_path):
+    """普通任务的新尝试：失败返工或显式重开已通过版本，均保留旧判定。"""
+    from . import lock, tasks as tasks_mod
+
+    decisions = tasks_mod._load_decision_list(decision_path)
+    if len(decisions) != 1:
+        raise ReviewError("WF_SEMANTIC_DECISION", {"reason": "restart requires exactly one human decision"})
+    decision = decisions[0]
+    task_id = task.get("id")
+    reopen_passed = decision.get("choice") == "reopen-reviewed"
+    if (decision.get("choice") not in ("restart-review", "reopen-reviewed") or decision.get("subject") != task_id
+            or not str(decision.get("source") or "").startswith("human:")
+            or not decision.get("at") or not str(decision.get("reason") or "").strip()):
+        raise ReviewError("WF_SEMANTIC_DECISION", {"reason": "restart decision must identify this task and human authorization"})
+    decision_ref = records.plain_digest(decision)
+    with lock.acquire(ctx.root, holder_hint="review-restart"):
+        tasks_mod._require_binding(ctx, task_id)
+        _writer, holder = ctx.require_held(task=task_id)
+        path = _task_dir(ctx, task)
+        task = records.load_json(os.path.join(path, "task.json"))
+        if (task.get("status") != "in_progress" or task.get("phase") != "finish"
+                or task.get("paused") or task.get("suspended") or task.get("terminal")
+                or task.get("kind") != "ordinary" or task.get("run_id")
+                or (task.get("plan") or {}).get("complexity") != "complex"):
+            raise ReviewError("WF_SEMANTIC_DECISION", {"reason": "restart requires an active ordinary complex task after Check"})
+        check = task.get("check") or {}
