+        anchor, _parts = _current_anchor(ctx, task)
+        if ((check.get("anchor") or {}).get("check_anchor") != anchor
+                or decision.get("object_digest") != anchor or decision.get("check_id") != check.get("id")):
+            raise ReviewError("WF_CHECK_STALE", {"reason": "restart decision or Check does not match current content"})
+        reviews = task.setdefault("reviews", {})
+        attempts = reviews.get("attempts") or []
+        inputs = {"task": task_id, "decision_ref": decision_ref, "check_id": check.get("id")}
+        existing = next((entry for entry in attempts if entry.get("rework_ref") == decision_ref), None)
+        if existing is not None:
