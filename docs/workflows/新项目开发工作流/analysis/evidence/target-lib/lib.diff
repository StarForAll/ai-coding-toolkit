+def _terminal_auto_session_candidate(ctx):
+    """只读预筛：返回可能处于 S3 的会话，其他 enable 不必争写锁。"""
+    from . import identity_store as store, tasks
+
+    key, attachment = ctx._auto_resolve()
+    binding = session_mod.load_binding(ctx.root, key) if key else None
+    if not binding or not attachment:
+        return None
+    obj = binding.get("object") or {}
+    if obj.get("kind") != "task":
+        return None
+    task = tasks.load_task(ctx.root, obj.get("id"))
+    if not task or task.get("status") != "archived":
+        return None
+    writer = ctx.writer()
+    if writer.get("state") != "idle" or writer.get("holder") or writer.get("recovering"):
+        return None
+    return key, attachment, binding, writer
+
+
+def _renew_terminal_auto_session(ctx):
+    """显式 enable 的 S3 出口；候选在锁内复核后再轮换。"""
+    from . import identity_store as store, lock
+
+    if ctx.explicit_session() is not None or _terminal_auto_session_candidate(ctx) is None:
+        return
+    with lock.acquire(ctx.root, holder_hint="enable"):
+        candidate = _terminal_auto_session_candidate(ctx)
+        if candidate is None:
+            return
+        _key, attachment, binding, writer = candidate
+        if store.five_state(attachment, dict(binding, object_terminal=True), writer) == store.S3:
