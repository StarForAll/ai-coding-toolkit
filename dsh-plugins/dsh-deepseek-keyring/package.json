{
  "name": "dsh-deepseek-keyring",
  "version": "0.1.0",
  "private": true,
  "description": "多把 DeepSeek 官方 API Key 自动轮换：可拖拽的余额胶囊显示当前 Key 余额与有效 Key 合计，点开后批量补充并可按范围导出 Key。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "test.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test.mjs"
  }
}
